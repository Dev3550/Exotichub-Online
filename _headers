# Cloudflare Pages Custom Headers Configuration

# Allow CORS for all API / asset requests
/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer-when-downgrade
  X-Robots-Tag: index, follow

# HTML pages - dynamic SSR and clean crawl headers for Bing & Google
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Homepage & Regional Landing pages
/
  Cache-Control: public, max-age=0, must-revalidate

# Fast caching for video catalog data
/sample_videos.json
  Cache-Control: public, max-age=300, s-maxage=600, stale-while-revalidate=120
  Content-Type: application/json; charset=utf-8

# XML Sitemaps - correct MIME type and caching
/*.xml
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: application/xml; charset=utf-8

# Cache control for CSS and JS assets
/*.css
  Cache-Control: public, max-age=86400

/*.js
  Cache-Control: public, max-age=86400

/*.txt
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/plain; charset=utf-8

